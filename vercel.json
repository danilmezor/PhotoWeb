{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/stats/script.js", "destination": "https://umami-zeta-gray.vercel.app/script.js" },
    { "source": "/stats/api/send", "destination": "https://umami-zeta-gray.vercel.app/api/send" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(photos|depth|splats)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ':!docs' ':!scripts/seo/indexnow-submitted.generated.json'"
}
